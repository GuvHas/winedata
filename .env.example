# ---------------------------------------------------------------------------
# Munskänkarna ingestion
# ---------------------------------------------------------------------------
# The Vinlocus review pages used by this project are public, so no credentials
# are required for the default sync. Set these only if you need to reach
# member-restricted pages.
#
# Preferred: paste the full Cookie header from an authenticated browser session
# (DevTools -> Network -> any munskankarna.se request -> Request Headers -> Cookie).
MUNSKANKARNA_COOKIE=

# Alternative: credentials used to attempt a form login before crawling.
# Falls back to anonymous access if the login flow cannot be completed.
MUNSKANKARNA_USERNAME=
MUNSKANKARNA_PASSWORD=

# Base URL override (useful for testing against a mirror or fixture server).
MUNSKANKARNA_BASE_URL=https://www.munskankarna.se

# Politeness: milliseconds to wait between requests (default 750).
INGEST_DELAY_MS=750

# ---------------------------------------------------------------------------
# Systembolaget enrichment (optional)
# ---------------------------------------------------------------------------
# Product links are always generated from the article number and need no key.
# A key enables enrichment with live price/volume/alcohol/country metadata via
# Systembolaget's external API. Without it, sync uses Munskänkarna's own values.
# Note: systembolaget.se and its API are geo-restricted to Sweden.
SYSTEMBOLAGET_API_KEY=
SYSTEMBOLAGET_API_BASE=https://api-extern.systembolaget.se/sb-api-ecommerce/v1
